class node {
  int val;
  node next;

  node(int val) {
    this.val = val;
  }
}

public class reverseLL {
  public static void main(String[] args) {
    node a = new node(10);
    node b = new node(20);
    node c = new node(30);
    node d = new node(40);
    node e = new node(50);
    a.next = b;
    b.next = c;
    c.next = d;
    d.next = e;
    e.next = null;
    node head = a;
    node p = null;
    node curr = head;
    node n = curr.next;
    while (curr != null) {
      n = curr.next;
      curr.next = p;
      p = curr;
      curr = n;
    }
    while (p != null) {
      System.out.print(p.val + " ");
      p = p.next;
    }
  }
}
